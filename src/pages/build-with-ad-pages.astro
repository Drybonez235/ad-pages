---
import FooterAstroComponent from '../components/Footer.astro';
import NavAstroComponent from '../components/Nav.astro';
import '../styles/global.css';

import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';

const searchResults = [
  {
    iconColor: 'bg-[var(--color-brand-cyan)]',
    hoverBg: 'hover:bg-[var(--color-brand-cyan)]/20',
    dotColor: 'text-[var(--color-brand-cyan)]',
    title: "Custom Forms.",
    description: "We build beautiful forms that invite customers to share their contact info. Our forms are powered by Google and come with all the bells and wistles. "
  },
  {
    iconColor: 'bg-[var(--color-brand-green)]',
    hoverBg: 'hover:bg-[var(--color-brand-green)]/20',
    dotColor: 'text-[var(--color-brand-green)]',
    title: "G4A and Google Tag integration.",
    description: "We inject your Google Tag into your site so you can track your click perfomrance."
  },
  {
    iconColor: 'bg-[var(--color-brand-green)]',
    hoverBg: 'hover:bg-[var(--color-brand-green)]/20',
    dotColor: 'text-[var(--color-brand-green)]',
    title: "Pages that highlight values, customer reviews, and mission.",
    description: "We use concepts from pschcology and social sciences to build trustworthy landing pages. "
  }
];
---

<BaseLayoutAstroComponent
 title="Ad-pages: Build with Ad-pages.com" 
  description="Ad-pages is a transparent platform that makes money off of you, not your data."
  image="/ad-pages-logo-color.svg"
>
<section id="build-fast" class="min-h-dvh w-full">
  <div class="text-black font-mono">
    
    <!-- Top Header & Search Navigation Area -->
  <NavAstroComponent searchText="Why build with Ad-pages.com?"></NavAstroComponent> 
    <!-- Main Content Area -->
    <main class="max-w-4xl mx-auto px-6 pb-20">
      <h3 class="text-3xl/9 font-serif font-normal mb-8 text-black pl-2">Ad-pages.com Features</h3>

      <!-- Search Results List -->
      <div class="flex flex-col gap-8">
        {searchResults.map((result) => (
          <div 
            class={`group block p-4 transition-colors duration-150 border border-transparent hover:border-black/10 ${result.hoverBg}`}
          >
            <!-- Domain Header -->
            <div class="flex items-center gap-2 mb-2">
              <span class={`size-6 rounded-full ${result.iconColor} inline-block shrink-0`}></span>
              <span class="text-xs/4 font-sans text-black">Ad-pages.com</span>
            </div>

            <!-- Result Title -->
            <h2 class="text-lg/6 font-bold font-sans text-black mb-2 group-hover:underline">
              {result.title}
            </h2>

            <!-- Result Snippet -->
            <p class="text-xs/5 font-sans text-black/90 max-w-3xl">
              {result.description}
            </p>
          </div>
        ))}
      </div>
    </main>

    
  </div>
</section>
</BaseLayoutAstroComponent>