---
import FooterAstroComponent from '../components/Footer.astro';
import NavAstroComponent from '../components/Nav.astro';
import '../styles/global.css';

import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';

const searchResults = [
  {
    iconColor: 'bg-[var(--color-brand-cyan)]',
    hoverBg: 'hover:bg-[var(--color-brand-cyan)]/20',
    dotColor: 'text-[var(--color-brand-cyan)]',
    title: "We build custom landing pages for your ads.",
    description: "At Ad-pages, we craft and customize landing pages that match the quality of your ads. No more dealing with Wordpress, SqaureSpace, Wix, or whatever bespoke framework your client uses. We can build and host your ad's landing page.",
    
  },
  {
    iconColor: 'bg-[var(--color-brand-lavender)]',
    hoverBg: 'hover:bg-[var(--color-brand-lavender)]/20',
    dotColor: 'text-[var(--color-brand-lavender)]',
    title: "Mock-up, feedback, iterate, repeat.",
    description: "Our technology allows us to build fast. Your feedback insures a landing page that matches your client's brand. We maintain open lines of communication and activly seek feedback.",
    
  }
];
---

<BaseLayoutAstroComponent
 title="Ad-pages: Build Fast" 
  description="Ad-pages allows you to quickly iterate on the perfect landing page for your Google and Meta ads. No more worrying about your client's webiste. You can make a custom landing page that compliments your ads!"
  image="/ad-pages-logo-color.svg"
>
<section id="build-fast" class="min-h-dvh w-full">
  <div class="text-black font-mono">
    
    <!-- Top Header & Search Navigation Area -->
  <NavAstroComponent searchText="How to build landing pages quickly."></NavAstroComponent> 
    <!-- Main Content Area -->
    <main class="max-w-4xl mx-auto px-6 pb-20">
      <h3 class="text-3xl/9 font-serif font-normal mb-8 text-black">Lightning Fast Iteration</h3>

      <!-- Search Results List -->
      <div class="flex flex-col gap-8">
        {searchResults.map((result) => (
          <div
            class={`group block p-4 transition-colors duration-150 border border-transparent hover:border-black/10 ${result.hoverBg}`}
          >
            
            <div class="flex items-center gap-2 mb-2">
              <span class={`size-6 rounded-full ${result.iconColor} inline-block shrink-0`}></span>
              <span class="text-xs/4 font-sans text-black">Ad-pages.com</span>
            </div>

           
            <h2 class="text-lg/6 font-bold font-sans text-black mb-2 group-hover:underline">
              {result.title}
            </h2>

            
            <p class="text-xs/5 font-sans text-black/90 max-w-3xl">
              {result.description}
            </p>
          </div>
        ))}
      </div>
    </main>

    
  </div>
</section>
</BaseLayoutAstroComponent>