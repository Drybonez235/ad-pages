---
import '../styles/global.css'
import BaseLayout  from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Ad-pages: Branding" 
  description="Ad-pages allows you to quickly iterate on the perfect landing page for your Google and Meta ads. No more worrying about your client's webiste. You can make a custom landing page that compliments your ads!"
  image="/ad-pages-logo-color.svg"
>
<main class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight">Brand Color Palette</h1>
  </header>
    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-cyan)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Cyan</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(84.62% 0.0536 196.18)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-blue)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Blue</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(67.78% 0.1713 276.06)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-lavender)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Lavender</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(71.04% 0.1904 305.15)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-red)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Red</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(73.95% 0.1588 21.68)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-orange)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Orange</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(80.11% 0.1206 43.83)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-green)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Green</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(81.63% 0.0425 148.46)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-gray)]"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Gray</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(44.87% 0.0039 17.30)</p>
      </div>
    </div>

    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200/60">
      <div class="h-36 w-full bg-[var(--color-brand-paper)] border-b border-slate-100"></div>
      <div class="p-4">
        <h2 class="font-semibold text-slate-800">Paper</h2>
        <p class="font-mono text-xs text-slate-500 mt-1">oklch(89.77% 0.0052 325.62)</p>
      </div>
    </div>

  </main>
  </BaseLayout>