---
import FooterAstroComponent from '../components/Footer.astro';
import NavAstroComponent from '../components/Nav.astro';
import '../styles/global.css';
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';

const searchResults = [
  {
    iconColor: 'bg-[var(--color-brand-green)]',
    hoverBg: 'hover:bg-[var(--color-brand-green)]/20',
    dotColor: 'text-[var(--color-brand-green)]',
    title: "We use technologies that deliver speed and reliability.",
    description: "Slow landing pages kill conversion. We build on Cloudflare's global infrastructure allowing you to deliver content to your audience no matter where they are clicking from. We use Astro to build lightweight landing pages that ship with no bloat or overhead.",
  },
  {
    iconColor: 'bg-[var(--color-brand-orange)]',
    hoverBg: 'hover:bg-[var(--color-brand-orange)]/20',
    dotColor: 'text-[var(--color-brand-orange)]',
    title: "We craft cohesive landing pages that guide your audience.",
    description: "Ironically, the best landing pages keep your audience from thinking about their next step. Unlike this site, our landing pages gently lead your audience to the final step and converts them to a customer.",
  }
];
---

<BaseLayoutAstroComponent
 title="Ad-pages: Build Performant" 
  description="Ad-pages allows you to build lighting fast landing pages that load nearly instantly. No more worrying about your client's slow website."
  image="/ad-pages-logo-color.svg"
>
<section id="build-fast" class="min-h-dvh w-full">
  <div class="text-black font-mono">
    
    <!-- Top Header & Search Navigation Area -->
  <NavAstroComponent searchText="How to build performant pages?"></NavAstroComponent> 
    <!-- Main Content Area -->
    <main class="max-w-4xl mx-auto px-6 pb-20">
      <h3 class="text-3xl/9 font-serif font-normal mb-8 text-black">Pages That Convert</h3>

      <!-- Search Results List -->
      <div class="flex flex-col gap-8">
        {searchResults.map((result) => (
          <div
            
            class={`group block p-4 transition-colors duration-150 border border-transparent hover:border-black/10 ${result.hoverBg}`}
          >
            <!-- Domain Header -->
            <div class="flex items-center gap-2 mb-2">
              <span class={`size-6 rounded-full ${result.iconColor} inline-block shrink-0`}></span>
              <span class="text-xs/4 font-sans text-black">Ad-pages.com</span>
            </div>

            <!-- Result Title -->
            <h2 class="text-lg/6 font-bold font-sans text-black mb-2 group-hover:underline">
              {result.title}
            </h2>

            <!-- Result Snippet -->
            <p class="text-xs/5 font-sans text-black/90 max-w-3xl">
              {result.description}
            </p>
          </div>
        ))}
      </div>
    </main>

    
  </div>
</section>
</BaseLayoutAstroComponent>