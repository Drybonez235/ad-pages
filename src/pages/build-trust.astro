---
import FooterAstroComponent from '../components/Footer.astro';
import NavAstroComponent from '../components/Nav.astro';
import '../styles/global.css';

import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';

const searchResults = [
  {
    iconColor: 'bg-[var(--color-brand-blue)]',
    hoverBg: 'hover:bg-[var(--color-brand-blue)]/20',
    dotColor: 'text-[var(--color-brand-blue)]',
    title: "We don't track you or your customer's data.",
    description: "You track your ad performance, but we don't! The data that flows through our landing pages is not retained or used by us. We make our money from you, not your customer's data."
  },
  {
    iconColor: 'bg-[var(--color-brand-lavender)]',
    hoverBg: 'hover:bg-[var(--color-brand-lavender)]/20',
    dotColor: 'text-[var(--color-brand-lavender)]',
    title: "We keep this site simple.",
    description: "If customers ever question ad-pages.com, they can click and see a simple, friendly website. No tracking, URL redirects, or confusing buisness structures. "
  }
];
---

<BaseLayoutAstroComponent
 title="Ad-pages: Build Trust" 
  description="Ad-pages is a transparent platform that makes money off of you, not your data."
  image="/ad-pages-logo-color.svg"
>
<section id="build-fast" class="min-h-dvh w-full">
  <div class="text-black font-mono">
    
    <!-- Top Header & Search Navigation Area -->
  <NavAstroComponent searchText="How to build trustworthy landing pages?"></NavAstroComponent> 
    <!-- Main Content Area -->
    <main class="max-w-4xl mx-auto px-6 pb-20">
      <h3 class="text-3xl/9 font-serif font-normal mb-8 text-black">No Predatory Tracking</h3>

      <!-- Search Results List -->
      <div class="flex flex-col gap-8">
        {searchResults.map((result) => (
          <div 
            class={`group block p-4 transition-colors duration-150 border border-transparent hover:border-black/10 ${result.hoverBg}`}
          >
            <!-- Domain Header -->
            <div class="flex items-center gap-2 mb-2">
              <span class={`size-6 rounded-full ${result.iconColor} inline-block shrink-0`}></span>
              <span class="text-xs/4 font-sans text-black">Ad-pages.com</span>
            </div>

            <!-- Result Title -->
            <h2 class="text-lg/6 font-bold font-sans text-black mb-2 group-hover:underline">
              {result.title}
            </h2>

            <!-- Result Snippet -->
            <p class="text-xs/5 font-sans text-black/90 max-w-3xl">
              {result.description}
            </p>
          </div>
        ))}
      </div>
    </main>

    
  </div>
</section>
</BaseLayoutAstroComponent>