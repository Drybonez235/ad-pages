---
const SITE_DEFAULT_DESC = 'At Ad-pages we build landing pages for Google and Meta ads. Building landing pages using a companys tech stack can be slow and daunting. With Ad-pages you can have a landing page built in no time.';
const SITE_DEFAULT_IMG = '/favicon.svg'; // Placed in public/ folder

export interface BusinessInfo {
  name: string;
  legalName?: string;
  url: string;
  logo: string;
  description: string;
}
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: 'website' | 'article';
  businessInfo?: BusinessInfo;
}

// 1. Initialize your default business object HERE inside the component
const DEFAULT_BUSINESS_INFO: BusinessInfo = {
  name: 'Ad-pages.com',
  url: 'https://ad-pages.com/',
  logo: '/ad-pages-logo-color.svg',
  description: 'At Ad-pages we build landing pages for Google and Meta ads. Building landing pages using a companys tech stack can be slow and daunting. With Ad-pages you can have a landing page built in no time.',
};

const {
  title,
  description = SITE_DEFAULT_DESC,
  image = SITE_DEFAULT_IMG,
  type = 'website',
  businessInfo = DEFAULT_BUSINESS_INFO,
} = Astro.props;

const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);

let jsonLD = null;

if (businessInfo) {
  jsonLD = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": businessInfo.name,
    "legalName": businessInfo.legalName || businessInfo.name,
    "url": businessInfo.url,
    "logo": businessInfo.logo,
    "image": image, // Fallback to the page's open graph image for search engines
    "description": businessInfo.description,
  };
}
---

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Standard Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Apple Touch Icon (Google often uses this for high-DPI displays) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
{jsonLD && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
)}