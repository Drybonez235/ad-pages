---
interface Props {
  searchText?: string;
}

const { 
  searchText = "How to host Google and Meta ad landing pages?" 
} = Astro.props;

// Get the current path from the page URL
const currentPath = Astro.url.pathname;

const navLinks = [
  { id: 'fast', label: 'Build Fast', href: '/build-fast/' },
  { id: 'performant', label: 'Build Performant', href: '/build-performant/' },
  { id: 'trust', label: 'Build Trust', href: '/build-trust/' },
  { id: 'ad-pages', label: 'Build with Ad-pages', href: '/build-with-ad-pages/' },
  { id: 'contact', label: 'Contact', href: '/contact-us/'}
];
---

<header class="pt-8 max-w-5xl px-6">
  <div class="flex items-start gap-6">
    
    <!-- Logo Container -->
    <a href="/" class="hidden md:block shrink-0 relative size-28 ">
      <img 
        src="/ad-pages-logo-color.png" 
        alt="Ad-Pages Logo" 
        class="absolute inset-0 size-full object-contain" 
      />
    </a>

    <!-- Right Side Stack: Search Box + Inline Nav -->
    <div class="flex flex-col gap-4 grow max-w-2xl">
      
      <!-- Search Bar Container -->
      <div>
        <span class="block text-xs/4 text-[var(--color-brand-gray)] mb-1">Ad-Pages.com</span>
        <div class="flex items-center gap-3 border border-black px-3 py-2 bg-white">
          <svg class="size-5 text-[var(--color-brand-orange)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            value={searchText} 
            class="w-full text-sm/5 bg-transparent border-none outline-hidden text-black font-sans"
            readOnly
          />
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="flex items-center gap-8 text-sm/5 font-sans">
        {navLinks.map((link) => {
          // Check if current URL matches the link target or anchor
          const isActive = currentPath === link.href || (currentPath === '/' && link.id === 'fast');

          return (
            <a 
              href={link.href} 
              class:list={[
                'hover:scale-102',
                isActive 
                  ? 'font-medium bg-brand-orange/30 p-1 px-2 rounded-xs' 
                  : 'no-underline font-normal'
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

    </div>
  </div>
</header>
<div class="border-b border-black mt-3 mb-12"></div>